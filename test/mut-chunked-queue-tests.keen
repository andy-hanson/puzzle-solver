import
	../private/mut-chunked-queue

test
	a nat8 mut-chunked-queue = chunk-size: 2
	enqueue a, (1, 2)
	trusted inspect-then-dequeue a, of x
		x is 1, 2
		enqueue a, (3, 4)
	any a is true
	trusted inspect-then-dequeue a, of x
		x is 3, 4
	any a is false

test
	a nat8 mut-chunked-queue = chunk-size: 2
	enqueue a, (1, 2)
	enqueue a, (3, 4)
	enqueue a, (5, 6)
	dequeue a is 1, 2
	enqueue a, (7, 8)
	enqueue a, (9, 10)
	dequeue a is 3, 4
	dequeue a is 5, 6
	dequeue a is 7, 8
	dequeue a is 9, 10
	dequeue a is ()
